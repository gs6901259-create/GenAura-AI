# ==============================================================================
# GenAura AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure keys for your environment.
# Note: GenAura AI operates with a fully functioning Deterministic Knowledge Engine
# out-of-the-box if no API keys are provided (zero mandatory setup required).
# ==============================================================================

# Google Gemini API Key for Live AI Assistant Responses
# Get a key from: https://aistudio.google.com
VITE_GEMINI_API_KEY=

# Preferred AI Model Name (Default: gemini-1.5-flash)
VITE_AI_MODEL=gemini-1.5-flash

# Backend Server Port (for lightweight API proxy)
PORT=3000

# Authentication Provider Mode ('demo' or 'production')
VITE_AUTH_PROVIDER=demo
