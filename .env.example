# ==============================================================================
# GenAura AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure keys for your environment.
# Note: GenAura AI operates with a fully functioning Deterministic Knowledge Engine
# out-of-the-box if no API keys are provided (zero mandatory setup required).
# ==============================================================================

# Google Gemini API Key for Live AI Assistant Responses
# Get a key from: https://aistudio.google.com
VITE_GEMINI_API_KEY=

# Preferred AI Model Name (Default: gemini-1.5-flash)
VITE_AI_MODEL=gemini-1.5-flash

# Backend Server Port (for lightweight API proxy)
PORT=3000

# Authentication Provider Mode ('demo' or 'production')
VITE_AUTH_PROVIDER=demo

# ==============================================================================
# Google OAuth 2.0 Client Configuration (OpenID Connect + PKCE)
# ==============================================================================
# Instructions:
# 1. Open Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID of type "Web application"
# 3. Add Authorized JavaScript origins:
#    - http://localhost:5173
#    - http://localhost:3000
# 4. Add Authorized redirect URIs:
#    - http://localhost:5173/auth/callback
#    - http://localhost:3000/auth/callback
# 5. Paste the Client ID below (Client Secret is NOT required for PKCE web client):
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# ==============================================================================
# Indian Payment Gateway Configuration (Razorpay India / UPI / NetBanking)
# ==============================================================================
# When running without keys, GenAura AI operates in a fully functional SANDBOX GATEWAY mode.
# To connect your live Razorpay Indian account, obtain credentials from:
# https://dashboard.razorpay.com/#/app/keys
VITE_PAYMENT_MODE=sandbox
VITE_RAZORPAY_KEY_ID=
VITE_RAZORPAY_KEY_SECRET=
VITE_PAYMENT_WEBHOOK_SECRET=


